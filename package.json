{
  "name": "chiyao-tech-website",
  "version": "1.0.0",
  "private": true,
  "description": "云南驰耀科技有限公司企业官网 - 前台展示 + 后台管理系统",
  "workspaces": [
    "server",
    "frontend",
    "admin"
  ],
  "scripts": {
    "setup": "npm install",
    "dev:server": "npm run dev --workspace server",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:admin": "npm run dev --workspace admin",
    "dev": "concurrently -n server,frontend,admin -c blue,green,magenta \"npm run dev:server\" \"npm run dev:frontend\" \"npm run dev:admin\"",
    "build": "npm run build --workspace frontend && npm run build --workspace admin",
    "build:frontend": "npm run build --workspace frontend",
    "build:admin": "npm run build --workspace admin",
    "start": "npm run start --workspace server",
    "prod": "node scripts/prod.mjs",
    "prod:start": "node server/src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop chiyao-site",
    "pm2:restart": "pm2 restart chiyao-site",
    "pm2:logs": "pm2 logs chiyao-site",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}